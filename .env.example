# Copiar a `.env` y completar. El `.env` real no se versiona.

# Proyecto de Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Solo la clave `anon` pública. NUNCA la `service_role`: esto viaja al navegador.
VITE_SUPABASE_ANON_KEY=eyJ...

# Dominio público donde queda publicada la app.
#
# Es lo que se codifica en el QR impreso en cada etiqueta de palet, así que tiene
# que ser el dominio definitivo: las etiquetas son físicas y quedan pegadas al
# palet durante meses. Si acá queda `localhost`, los QR impresos no van a
# funcionar fuera de esa computadora.
VITE_URL_PUBLICA=https://aibar-deposito.netlify.app
